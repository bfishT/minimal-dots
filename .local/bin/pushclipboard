#!/bin/bash

# 私有设置（默认目标主机等）放在 ~/.config/dotfiles-private/，不入公开仓库
[ -r "$HOME/.config/dotfiles-private/env.sh" ] && . "$HOME/.config/dotfiles-private/env.sh"

declare -a timeout
declare -a read_t
declare -a ssh_options
ssh_key=
buildline=0
gfxsys=
remote_gfxsys=

usage() {
cat <<HELP
Usage:
	$0 [ -v ] [ -t {n} ] [ -4 | -6 ] [ -x | -w ] [ -r {x|w} ] [ -i sshkey ] {target computer}
Copies the content of Wayland's clipboard to the target computer

Options:
	-t {n}	timeout for n seconds
	-4	connect SSH over IPv4
	-6	connect SSH over IPv6
	-w	use Wayland (auto-detected) for local clipboard
	-x	use X11 (fall-back) for local clipboard
	-r w	remote target uses Wayland (default)
	-r x	remote target uses X11
	-v	verbose
	-i [sshkey]	Use sshkey as identity
	-f	build authorized_keys' forced-command line
HELP
	exit "$1"
}

# Process options
while getopts "t:46wxvi:fr:-:h" o; do
	case "${o}" in
		t)
			timeout=( timeout "${OPTARG}" )
			read_t=( '-t' "${OPTARG}" )
			;;
		4|6|v)	ssh_options+=( "-${o}" )	;;
		i)	ssh_key="${OPTARG}"
			if [[ ! -r "${ssh_key}" ]]; then
				echo "Cannot read ${ssh_key}" 1>&2
				exit 2
			else
				echo "Using ${ssh_key}"
			fi
			;;
		f)	buildline=1	;;
		w)	gfxsys=wayland	;;
		x)	gfxsys=x11	;;
		r)	case "${OPTARG}" in
				w)	remote_gfxsys=wayland	;;
				x)	remote_gfxsys=x11	;;
				*)	printf 'Bad -r option: %s (use w or x)\n' "${OPTARG}"; usage 2 1>&2	;;
			esac
			;;
		h)	usage 0	;;
		-)	case "${OPTARG}" in
				help)	usage 0	;;
				*)	printf 'Bad option %s\n\n' "${OPTARG}"; usage 2	1>&2	;;
			esac
			;;
		*)	printf 'Bad option %s\n\n' "${o}"; usage 2	1>&2	;;
	esac
done
shift $((OPTIND-1))

DEFAULT_TARGET="${CLIPBOARD_TARGET:-}"

if [[ -z "${1}" ]] && (( ! buildline )); then
	if [[ -z "${DEFAULT_TARGET}" ]]; then
		printf 'No target given, and CLIPBOARD_TARGET is not set.\n' 1>&2
		printf 'Set it in ~/.config/dotfiles-private/env.sh, or pass a target:\n' 1>&2
		printf '  %s user@host\n' "$0" 1>&2
		exit 2
	fi
	target="${DEFAULT_TARGET}"
	echo "Using default target: ${target}"
else
	target="${1}"
fi


# Search clipboard-specific SSH key
if [[ -z "${ssh_key}" ]]; then
	search_ssh_key=( ~/.ssh/id_*_clipboard )
	if [[ -r "${search_ssh_key[0]}" ]]; then
		ssh_key="${search_ssh_key[0]}"
		printf 'Found key:\t%s\n' "${ssh_key}"
	fi
fi

# Build forced command line for the ssh_authorized config
if (( buildline )); then
	echo '# forced command in ~/.ssh/ssh_authorized'
	if [[ -z "${ssh_key}" ]]; then
		echo 'No key available to build a forced-command line' 1>&2
		exit 1
	fi
	echo "# Wayland"
	printf "command=\"/usr/bin/env WAYLAND_DISPLAY='wayland-1' wl-copy; echo copied\",no-agent-forwarding,no-pty,no-X11-forwarding %s\n" "$(< "${ssh_key%.pub}.pub" )"
	echo "# X11"
	printf 'command="xclip -display :0 -in -rmlastnl -selection clipboard; echo copied",no-agent-forwarding,no-pty,no-X11-forwarding %s\n' "$(< "${ssh_key%.pub}.pub" )"
	exit 0
fi


# Auto-detect display server
if [[ -n "${gfxsys}" ]]; then
	:
elif [[ "${XDG_SESSION_TYPE,,}" =~ wayland|x11 ]]; then
	gfxsys="${XDG_SESSION_TYPE,,}"
elif [[ -n "${WAYLAND_DISPLAY}" ]]; then
	gfxsys=wayland
	echo "Wayland detected"
elif [[ -n "${DISPLAY}" ]]; then
	gfxsys=x11
	echo "X11 detected"
fi

# Display-specific command
clipcmd=
if [[ "${gfxsys,}" == "x11" ]]; then
	clipcmd=( xclip -out -rmlastnl -selection clipboard ) # -display :0
else
	clipcmd=( wl-paste --no-newline )
fi


# Remote-side command
# Default SSH timeout options
ssh_conn_opts=( -o ConnectTimeout=5 -o ServerAliveInterval=3 -o ServerAliveCountMax=2 -o GSSAPIAuthentication=no )

if [[ -z "${remote_gfxsys}" ]]; then
	remote_gfxsys=wayland
fi
if [[ "${remote_gfxsys}" == "x11" ]]; then
	remote_cmd=( timeout 5 xclip -display :0 -in -rmlastnl -selection clipboard \; echo copied )
else
	remote_cmd=( timeout 5 /usr/bin/env WAYLAND_DISPLAY="wayland-1" wl-copy \; echo copied )
fi

# Copy-Paste time!
echo "Pushing clipboard to ${target} using ${clipcmd[0]} on ${gfxsys^} -> ${remote_gfxsys^}..."

while read ${read_t:+ "${read_t[@]}" } -r result; do
	ssh_pid="$!"
	echo -e "${result}"
	kill -TERM "${ssh_pid}"
	exit 0
done < <(
	exec	\
		${timeout:+ "${timeout[@]}" }	\
		ssh	\
			"${ssh_conn_opts[@]}"	\
			${ssh_options:+ "${ssh_options[@]}" }	\
			${ssh_key:+ -o"ControlPath none" -o"IdentitiesOnly yes" -i "${ssh_key}"}	\
			"${target}"	\
			--	\
				"${remote_cmd[@]}"	\
			< <( "${clipcmd[@]}" )	\
	|| echo "fail ?" >&2
)

echo "timeout" >&2
exit 1
